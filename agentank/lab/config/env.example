# Copy these names into your local shell or private .env file.
# Never commit real AgentTank keys.

AGENTANK_FREEZE_KEY=replace_with_freeze_tank_key
AGENTANK_TELEPORT_KEY=replace_with_teleport_tank_key

# Optional override for leaderboard experiments.
AGENTANK_LEADERBOARD_URL=https://agentank.ai/api/agent/leaderboard?period=all&sort=score&limit=50

